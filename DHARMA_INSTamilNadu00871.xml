            <div type="edition" xml:lang="nld-Latn" rendition="class:latin maturity:undetermined">
                
                <p>
                    <lb n="1"/>HIER LEYT <expan><abbr>BEGRAV</abbr><ex>EN</ex></expan> DEN
                    <lb n="2"/>EERSAMEN RE<choice><orig>Y</orig><reg>IJ</reg></choice>NIER <expan><abbr>VA</abbr><ex>N</ex></expan>
                    <lb n="3"/>BUYTEN DYCK VAN DORT                   
                    <lb n="4"/>IN S<choice><orig>Y</orig><reg>IJ</reg></choice>N LEVEN <expan><abbr>COOPM</abbr><ex>?</ex></expan>
                    <lb n="5"/>EN GUARNISOEN BOEH
                    <lb n="6"/>HOUDER DER STADT
                    <lb n="7"/>NAGAPATNAM IN DEN
                    <lb n="8"/>HEERE ONTSLAPEN DEN
                    <lb n="9"/>II= MEY A= 1684 OUD <hi rend="check">IN</hi>
                    <lb n="10"/>S<choice><orig>Y</orig><reg>IJ</reg></choice>N DE OMTRENT 64
                    <lb n="11"/>IAREN
                </p>
                
            </div>	
            
            <div type="apparatus">
                <listApp>
