            <div type="edition" xml:lang="tam-Latn" rendition="class:vaṭṭeḻuttu maturity:vernacular">
                
                <ab>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </ab>
                
                <p>                    
                   puriyaṉūr mukkāl vaṭṭat
                    <lb n="2" break="no"/>tuk kūṭi y-ūrār Avirōtattāṟ cey
                    <lb n="3" break="no"/>ta kaccam āvatu
                </p>
                
                <p>
                    paṭāriyār-uṭaiya nicca
                    <lb n="4" break="no"/>ṉa vaiyāyuḷḷavai paṭaikkum patuṇ niru
                    <lb n="5" break="no"/>māliyamum nantā-viḷakkum Oḷukka
                    <lb n="6" break="no"/>viyum nāḷ paṅkum pāratamun kū
                    <lb n="7" break="no"/>ttum paliyum taccum ivai Oṉpatum
                    <lb n="8"/>vilakkapeṟār vilakkuvō<unclear>r</unclear>
                    <lb n="9"/>mūḻikkaḷatt’ oḻukka viccava
                    <lb n="10" break="no"/>ttai piḻaiccōr āvōr Aṟamuṅ kūṭ<unclear cert="low">ār</unclear>
                </p>
            </div>
            
