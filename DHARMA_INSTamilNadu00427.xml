                <p>
                    <supplied reason="lost"><hi rend="grantha">tribhu</hi>vana</supplied>-c-ca<supplied reason="lost">kka</supplied>
                    <lb n="2" break="no"/>ra-va<reg>r</reg>tti kō<unclear>ṉēr</unclear><supplied reason="lost">iṉmaikoṇṭā</supplied>
                    <lb n="3" break="no"/>ṉ Uṭaiyār tiru-k-koṭuṅ-ku
                    <lb n="4" break="no"/>ṉṟam-uṭaiya ṉāyaṉār-kōyil
                    <lb n="5"/>tāṉattārkku Ik-kōyil mā
                    <lb n="6" break="no"/>ṭāpattiyam tiru-malai Uṭaiyā
                    <lb n="7" break="no"/><unclear>ṉum</unclear> tiru-mañcaṉam Uṭaiyāṉum
                    <lb n="8"/>kāṇi-y-āy varuva-c ceytu pō
                    <lb n="9" break="no"/>tukiṟa paṭiyālē Irupatt’ eṭṭā
                    <lb n="10" break="no"/>vatu mutal Ivarkaḷukku cantirā
                    <lb n="11" break="no"/>titta-vaṟ cellum paṭi ka<supplied reason="omitted">l</supplied>lilum
                    <lb n="12"/>cempilum veṭṭi-k koḷ
                    <lb n="13" break="no"/>vat’ āka-c coṉṉōm
                </p>
                <p>
                    Ip-paṭik
                    <lb n="14" break="no"/>ku kallilum cempilum ve<supplied reason="lost">ṭ</supplied>
