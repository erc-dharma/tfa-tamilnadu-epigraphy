            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <ab>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </ab>	
                
                <p>
                    tirupuvaṉa-c-cakkara-va<reg>r</reg>ttikaḷ maturai koṇṭu pāṇṭiyaṉ<unclear>ai</unclear> muṭi-t talaiyum koṇṭ-aruḷiya c<choice><orig>i</orig><reg>ī</reg></choice>-kulōttuṅka-cōḻa-tēvarkku y<choice><sic>ira</sic><corr>ā</corr></choice>ṇṭu <num value="17"><g type="numeral">10</g> 7</num>-Āvatu kumpa-nāyaṟṟu pūrva-patticattu titiyaiyum tiṅkaṭ-kiḻamaiyum peṟṟa Uttiraṭṭāti nāḷ
                </p>
                <p>
                    U<choice><orig>y</orig><reg>yy</reg></choice>a-k-koṇṭār-vaḷa-nāṭṭu muḻaiyūr-nāṭṭu Uṭaiyār tiru-naḷḷāṟ-uṭaiyār kōyil m<choice><orig>u</orig><reg>ū</reg></choice>la <choice><sic>k</sic><corr>p</corr></choice>irut<supplied reason="omitted">tiya</supplied>-Āti-<supplied reason="lost">ca</supplied>ṇṭēcura-<supplied reason="lost">t</supplied>ēva-<supplied reason="lost">kaṉm</supplied>ikaḷukku I-kōyil nimantakkāṟaril cōlai-<hi rend="check">Iṭarat<choice><orig>i</orig><reg>ī</reg></choice>ṟtāṉ</hi>-Āṉa muḻaiyūr-nāṭṭu kō<choice><orig>n</orig><reg>ṉ</reg></choice><supplied reason="lost">ē</supplied>ṉ <gap reason="lost" quantity="6" unit="character"/> ṇṭa <gap reason="lost" quantity="2" unit="character"/> Inn <gap reason="lost" quantity="2" unit="character"/> <unclear cert="low">ṟ</unclear>kku <gap reason="lost" quantity="12" unit="character"/> 
                    <lb n="2" break="no"/>ci viṭṭa commali y-āṭu <g type="numeral">10</g>
                </p>
                <p>
                    Ivv-āṭu pattum nāṉ kai-k-koṇṭu canti-viḷakk<supplied reason="lost">u</supplied> Oṉṟukku nāḷ Oṉṟukku <hi rend="check">maḷakku<unclear cert="low">ṭi</unclear>ney <choice><sic>a</sic><corr>i</corr></choice>ru ce<supplied reason="omitted">y</supplied></hi> Aḷakka kaṭavēṉ āka<supplied reason="omitted">vu</supplied>m
                </p>
                <p>
                    Aḷakku<choice><orig>mm</orig><reg>m</reg></choice> <choice><sic>a</sic><corr>i</corr></choice>ṭattu-v Āṭu pattum Ivaiyiṟ<unclear cert="low">ṟ</unclear> <gap reason="lost" quantity="2" unit="character"/> mēṟpaṭṭa vaṟttaṉaikaḷum nāṉum Eṉ vaṅkica<supplied reason="omitted">t</supplied>t<choice><sic>o</sic><corr>ā</corr></choice><unclear>ru</unclear>m aṉup<choice><sic>o</sic><corr>a</corr></choice>vitt<supplied reason="lost">u</supplied> cantirātitta-varai Aḷakka kaṭavōm āṉamaikk<supplied reason="lost">u</supplied>                    
                </p>
