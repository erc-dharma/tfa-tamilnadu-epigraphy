                    <lg n="1" met="āciriyappā">
                        <l n="1"><lb n="A1"/><gap reason="lost"/> muraṇuṟat tākki</l>
                        <l n="2">tikkaṇaik kīrtti takkaṇa-lāṭamum</l>
                        <l n="3">kōvinta cantaṉ māviḻin tōṭat</l>
                        <l n="4">taṅkāta cāral vaṅkāḷa-tēcamum</l>
                        <l n="5">toṭukaḻaṟ caṅku voṭṭa mayipālaṉai</l>
                        <l n="6">veñcamar <unclear>kaḷattu A</unclear><lb n="A2" break="no"/>ñcuvitt-aruḷi</l>
                        <l n="7"><unclear>Āṅkav</unclear>aṉaiyum peṇṭir paṇṭāramum</l>
                        <l n="8">nittila neṭuṅkaṭal Uttira-lāṭamum</l>
                        <l n="9">veṟimalar tīrtt<hi rend="grantha">dha</hi> ceṟipu<unclear>nar</unclear> kaṅk<choice><orig>a</orig><reg>ai</reg></choice>yum</l>
