            <div type="translation" source="bib:Ramachandran1954_01">                
                <p n="1">Hail prosperity!</p>
                <p n="1">The Nayakar <supplied reason="explanation">Buddha</supplied> who assured the salvation of scholarly Pandits that learnt the Āgama <supplied reason="subaudible">Nikaya which is Sutta piṭaka</supplied>.</p>
            </div>
            
            <div type="translation" resp="part:emfr">                              
                <p n="1">Hail prosperity!</p>
                <p n="1">The Lord who saved the one learned in Āgamas.</p>
            </div>
            
            <div type="commentary">
                <p></p>
            </div>
            
