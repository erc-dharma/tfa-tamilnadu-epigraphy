            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">               
                                
                <ab>
                    <milestone n="A" unit="zone" type="gridlike"/><label>Front side</label><lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </ab>
                <p>
                    <hi rend="grantha">Āgama-paṇḍi</hi>ta<hi rend="grantha">rai</hi> Uyya-k-ko<milestone n="B" unit="zone" type="gridlike" break="no"/><label>Right side</label>ṇṭa nāyakār
                </p>
                
