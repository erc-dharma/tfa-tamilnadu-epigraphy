        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <ab>
                    <lb n="1"/><hi rend="grantha">svasti</hi>
                </ab>	
                
                <p>
                    <hi rend="grantha">śrīman-mahā</hi>maṇṭalē<hi rend="grantha">śvara</hi>n <hi rend="grantha">har<supplied reason="lost">i</supplied></hi>rāya kumāraṉ v<choice><orig>i</orig><reg>ī</reg></choice>]ra-viruppaṇa Uṭaiyār piṟutuvi-rācciyam paṇṇi y-aruḷā <choice><sic>ṉ</sic><corr>n</corr></choice>i<choice><sic>n</sic><corr>ṉ</corr></choice>ṟa <hi rend="grantha">śakāp<choice><orig>t</orig><reg>d</reg></choice>aM</hi> <num value="1313"><g type="numeral">1000</g> 3 <g type="numeral">100</g> <g type="numeral">10+</g> 3</num>-ṉ mēl cellā niṉṟa
                    <lb n="2"/>piṟacāpati-varu<hi rend="grantha">ṣaM</hi> tulā-nāyaṟṟu <hi rend="grantha">pūrvva-pakṣa</hi>ttu veḷḷi-k-kiḻamaiyum peṟṟa pū<unclear>ca</unclear>ttu nāḷ                    
                </p>
                <p>
                    Irācēntira-cōḻa-vaḷa-nāṭṭu-p puṟaṅ-karampai-nāṭṭu-k kaṇakka-p piḷḷaikaḷil Eḻilū
                    <lb n="3" break="no"/>r-uṭaiyāṉ cūriya-tēvaṟkku Uyya-k-koṇṭa-cōḻa-vaḷa-nāṭṭu muḻaiyūr-nāṭṭu tiru-naḷḷāṟ-uṭaiya nāyaṉār kōyil Āti-caṇṭēcura-tēvakaṉmikaḷum <hi rend="grantha">śrī</hi>-ru<hi rend="grantha">dra-śrī</hi>-mā<hi rend="grantha">he</hi>curarum viṇ
                    <lb n="4" break="no"/>ṇappañ ceyya tiru-vāy-mala<supplied reason="omitted">r</supplied>nt-aruḷiṉa paṭikku Āti-caṇṭēcura-tēvar Aruḷi-c ce<supplied reason="omitted">y</supplied>ta paṭikku kāṇi vilai kuṭutta paṭi
                </p>
                <p>
                    Ik-kōyil kaṇakku kāṇi Uṭaiya <hi rend="grantha">janmi</hi>kaḷ <hi rend="grantha">prāpti</hi>māṉ<unclear>ka</unclear>
                    <lb n="5" break="no"/>ḷ Uḷḷavarkaḷum nēr-āka-c cettum kēṭṭum <hi rend="check"><unclear>ku</unclear></hi>mūlattum pō<choice><orig>n</orig><reg>ṉ</reg></choice>a paṭiyālu<hi rend="grantha">M pra</hi>mātūta-va<supplied reason="omitted">ru</supplied>ṣam maṇṭalam-āka viḷaiyāmal pañcamāy-t-tēcattil manittarum cettu Uṭaiyā=r tiru-naḷḷāṟ-u⌈                    
                    <lb n="6" break="no"/>ṭaiyār parikaramum Alki kōyilukku pūcai mikuti<unclear cert="low">k</unclear>ku-t tokai n<choice><orig>i</orig><reg>ī</reg></choice>kki nilaikku-k kuṭukka mutal Illāta paṭiyālē Ik-kōyil kaṇakku kāṇi kumpattaṉ naḷḷāṟ-uṭaiyā<choice><orig>n</orig><reg>ṉ</reg></choice> kāṇi pāti n<choice><orig>i</orig><reg>ī</reg></choice>kki kaṇkkāṇi E
                    <lb n="7" break="no"/>ḻ<choice><sic>u</sic><corr>i</corr></choice>lūr-uṭaiyāṉ cūriya-tēvaṟku taṇṭēcura-tēvar vilai-y-āka viṟṟu-k koṇṭa Ākuvarāmaṉ <g ref="sym:tam-panam"/> <num value="80">8 <g type="numeral">10</g></num>
                </p>
                
                <p>Ip-paṇam Eṇpatukkum kōyil kaṇakku kāṇiyum kāṇiyāl uḷḷa cuvantiraṅkaḷum maṉaiyum ⌈
                    <lb n="8" break="no"/>peṟṟu maṟṟum Uḷḷa cuvantiraṅkaḷum peṟṟu nāṭuṭai nāyaka-p-piriya<choice><orig>n</orig><reg>ṉ</reg></choice> Eṉṟu peṟṟu canti<choice><orig>ṟ</orig><reg>r</reg></choice>ātitta-varaiyum Aṉupavittu-p pō<choice><sic>t</sic><corr>k</corr></choice>a-k kaṭavaṉ ākavum</p>
                <p>Ip-paṭi tiru-vāy-mala<supplied reason="omitted">r</supplied>nt-aruḷiṉa paṭikku Āt<unclear>i</unclear>-caṇṭēcura-tēvar A<supplied reason="omitted">ru</supplied>ḷi-c ceya
                    <lb n="9" break="no"/>l paṭi Āti-caṇṭēcura-tēva-kaṉmikaḷum śrī-rutti<choice><orig>ṟ</orig><reg>r</reg></choice>a-śrī-mākēcurarum kāṇi vilai kuṭuttamaikku Ip-paṭikku
                    <list>
                        <item>Ivai māṭāpatt<unclear>i</unclear>yam vaṉṉiyūr kiḻavaṉ cāmuṇṭi-tēva<choice><orig>n</orig><reg>ṉ</reg></choice> Eḻuttu</item>
                        <item>Ivai kōyi<supplied reason="omitted">l</supplied> nāyakam caṭaiya-nāyaka-p-pira
                        <lb n="10" break="no"/>mārāyaṉ Eḻuttu</item>
                        <item>Ivai tēvakaṉmi Iḷamai nāyaṉ Eḻuttu</item>
                        <item>Ip-pa<add place="below">ṭi</add> Aṟivēṉ veṇṇai-nallūr-uṭaiyā<choice><orig>n</orig><reg>ṉ</reg></choice> kūttāṇāyaṉ-ēṉ</item>
                        <item>Ip-paṭi Aṟivēṉ vēḷūr kiḻavaṉ ti<add place="below">ru</add>kkai-vēl Aḻakiyāṉ-ē <choice><orig>n</orig><reg>ṉ</reg></choice></item>
                        <item>Ip-paṭi Aṟivēṉ pālāṟ-uṭaiyā<choice><orig>n</orig><reg>ṉ</reg></choice> pacuva<unclear>ṉ</unclear>-ē<supplied reason="omitted">ṉ</supplied></item>
                    </list>
                </p>
            </div>
            
