        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <div type="textpart" n="A"><head>Fragment 1</head>
                    
                    <ab>
                        <lb n="A1"/><supplied reason="lost"><hi rend="grantha">svasti śrī</hi></supplied>
                    </ab>
                    
                    <lg n="1" met="āciriyappā">
                        <l n="1"><supplied reason="lost">tiru</supplied> <unclear>ma</unclear>ṉṉi Iru-nila-maṭantaiyum</l>
                        <l n="2">pōr-ceya-p-pāvaiyuñ cīr-t-taṉi-c-celviyu<choice><sic>ṉ</sic><corr>n</corr></choice></l>
                        <l n="3">taṉ perun-tēviyar āki Iṉpuṟa</l>
                        <l n="4"><lb n="A2"/><unclear>ne</unclear>ṭituyal Ūḻiyuḷ iṭaituṟai-nāṭu<choice><sic>ṉ</sic><corr>n</corr></choice></l>
                        <l n="5">tuṭarvaṉa vēli-p paṭar vaṉa-vāciyuñ</l>
                        <l n="6">cuḷḷi cūḻmatiṭ koḷḷi-p-pākkaiyu<supplied reason="subaudible">m</supplied></l>
                        <l n="7">naṇṇaṟk' arumu<unclear>ra</unclear><lb n="A3" break="no"/>ṇ maṇṇai-k-kaṭakkamum</l>
                        <l n="8">poru-kaṭal īḻatt' araiyar ta<supplied reason="subaudible">m</supplied> muṭiyum</l>
                        <l n="9">Āṅkavar tēviyar Ōṅkeḻil muṭiyu<supplied reason="subaudible">m</supplied></l>
                        <l n="10">muṉṉavar pakkal teṉ</l>
                    </lg>
                    
                </div>
                
                <div type="textpart" n="B"><head>Fragment 2</head>
                    
                    <lg n="1" met="āciriyappā">
                        <l n="11"><lb n="B1"/>rai Īḻa-maṇṭala<supplied reason="subaudible">m</supplied> muḻuvatum</l>
                        <l n="12">Eṟipaṭai-k kēraḷar <gap reason="lost"/></l>
                        <l n="13"><lb n="B2"/><gap reason="lost"/> tol-perun-kāval palpaḻan tīvu<supplied reason="lost">m</supplied></l>
                        <l n="14"><gap reason="lost"/></l>
                        <l n="15">mā-p-poru taṇṭāṟ koṇṭa</l>
                    </lg>
                    <p>
                        kō-p-parakēcari-pa<hi rend="grantha">nma</hi> <gap reason="lost"/>
                        <lb n="B3"/><gap reason="lost"/> vatu
                    </p>
                    
                    <p>
                        <hi rend="grantha">kṣatri</hi>ya-<hi rend="grantha">śikhā</hi>māṇi-vaḷanāṭṭu-p paṭṭiṉa-k-kūṟṟattu nākappaṭṭiṉatt' ūrōm Ivvūr-t tiru-kā<supplied reason="lost">rōṇa</supplied> <gap reason="lost"/>
                        <lb n="B4"/>tēvaṟku tiru-v-amitukkum tiru-viḷakkukkum mācimaka-t-tirunāḷāl Āṟunāḷil tiru-viḷakkukku vē <gap reason="lost"/>
                        <lb n="B5" break="no"/>rum nakkaṉ perumā<choice><orig>n</orig><reg>ṉ</reg></choice>um nakkaṉ <gap reason="lost"/> Oṉṉa Irāma<choice><orig>n</orig><reg>ṉ</reg></choice>um Ivvaṉaivōm Ivvūr taṅkaḷ nilattil ku <gap reason="lost"/>
                        <lb n="B6"/><gap reason="lost"/> pulattil kuṭutta nilattukku kīḻ-pāṟk' ellai kumaraṉ tīravaṭikaḷ paṅkum Ivvūr cēṉāmukat tuṟkay <gap reason="lost"/>
                    </p>
                    
                </div>
                
                <div type="textpart" n="C"><head>Fragment 3</head>
                    
                    <p>
                        <lb n="C1"/>makaḷ An=tari cēn=tamāna cempiyaṉ mātēvi talaikkōli paṅkukku mēṟkum teṉ-pāṟk' ellai Ivūṟ viyāpāri kaliyaṉ māvēṉāṉa Irā<hi rend="grantha">ja</hi>        
                        <lb n="C2" break="no"/>rā<hi rend="grantha">ja</hi> tōṉṟi cilēṭṭi-k karaippulattukkum vēṃkaṭavaṉātittaṉ karaippulattukku vaṭakkum mēl-pāṟk' ellai Ivvūr maṭikai Āriya-c cālai-t tu
                        <lb n="C3" break="no"/><unclear>ṟ</unclear>kayār <unclear>tē</unclear>vatāṉa Akal-puṟattukku kiḻakkum vaṭa-pāṟk' ellai Ivvūr viyāpāri perumāṉakkaṉ nilattukkum tāyaṉ <unclear>kāriyam</unclear> paṭṭārikaḷ maṟaikkā
                        <lb n="C4" break="no"/>ṭaṉum nilattum maṭikai-t tuṟkayār tēvatāṉam-āṉa Akal-puṟattukku teṟkkum Ivvicainta peru-nāṉk' ellailyilum Akappaṭṭa nilam
                        <lb n="C5"/>Iraṇṭēy Ēḷu mā v-araiyum can=tirātittavaṟ Iṟaiyilyāka ceytu pātipāta
                        <lb n="C6" break="no"/>mūla-pañcācā<choice><sic>ṟṟ</sic><corr>r</corr></choice>iya-p-paṭṭ-uṭai-t tēvakaṉmikaḷum yānṭu Āṟ-āvatu <hi rend="grantha">śrī</hi>-kāriyam ceykira viṟkuṭayāṉ pa <gap reason="lost"/> ṉum colla
                        <lb n="C7" break="no"/>-k kalveṭṭi<choice><orig>n</orig><reg>ṉ</reg></choice>ēṉ Ivvūr taccaṉ nēṟaṉ caṭaya<choice><orig>ṉṉ</orig><reg>ṉ</reg></choice>-ā<choice><orig>n</orig><reg>ṉ</reg></choice>a <gap reason="lost"/> tikai pēriḷamaiy poṉ <gap reason="lost"/>
                    </p>
                    
                </div>
                
                <div type="textpart" n="D"><head>Fragment 4</head>
                    
                    <p>
                        <lb n="D1"/>-kūṟṟattu vūr-uṭaiyāṉ cēntaṉ
                        <lb n="D2"/><hi rend="grantha">śrī</hi>-kaṇṭācāriyaṉ <g ref="sym:tam-pillaiyarCuli" type="punctuation">.</g>
                    </p>
                    
                </div>
            </div>	
            
