        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <ab>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </ab>
                
                <p>                    
                    <hi rend="grantha">prasāda</hi>ñ ceyt-aruliṉa tiru-muka-p-paṭi kaḷveṭṭu
                </p>
                <p>
                    cēṉai mutaliyār kōyilukku-<supplied reason="lost">t te</supplied>ṉ-mēṟku <hi rend="grantha">A</hi>n=ta<hi rend="grantha">rāḷa-bhi</hi>t=tiyil veṭṭiṉa kaḷvettu
                </p>
                <p>
                    Ik-kōyil puṟaccāraṇaiyilē maṟaikiyāl Itu paṭi y-eṭuttu-k kalveṭṭiṉa paṭi
                </p>
                <p>
                    <hi rend="grantha">tribhu</hi>vaṉa-<hi rend="grantha">c-cakra</hi>vat=ti kōṉēriṉmaikoṇṭāṉ                    
                </p>
                
                <p>
                    tiru-malli-nāṭṭu <hi rend="grantha">brahmade</hi>yam <hi rend="grantha">śrī</hi>-villiputtūr <hi rend="grantha">brāhma</hi>ṇar <hi rend="check">perayūr</hi> pāḻpaṭukaiyāl Ivv-ūr <hi rend="grantha">sam<supplied reason="omitted">·</supplied>hari</hi>ttu ve<hi rend="grantha">da</hi>mum <hi rend="grantha">śāstra</hi>mum <hi rend="check">poy</hi> <hi rend="grantha">vyākhyā</hi>tarkkaḷ āy-irukkum catu<hi rend="grantha">rvvedi-bha</hi>ṭṭarkaḷ pēr nūṟṟ’ eṭṭukku paṅku nūṟṟ’ eṭṭum
                </p>
                
                <p>
                    <list>
                        <item>ve<hi rend="grantha">da-vṛ</hi>
                            <lb n="2" break="no"/>t=ti paṅku nālum</item>
                        <item><hi rend="grantha">śrī-rāmā</hi>yaṇa-<hi rend="grantha">vṛ</hi>t=ti paṅku Oṉṟum</item>
                        <item><hi rend="grantha">mahābhāra</hi>ta-vṛt=ti paṅku Oṉṟum</item>
                        <item><hi rend="grantha">jyo</hi>ti<hi rend="grantha">ṣa</hi>-vṛt=ti paṅku O<supplied reason="lost">ṉ</supplied>ṟum</item>
                        <item><hi rend="grantha">vaidya-vṛ</hi>t=ti paṅku Oṉṟum</item>
                        <item>paṇ-icai-<hi rend="grantha">vṛ</hi>t=ti paṅku Āṟum</item>
                    </list>
                    
                    Āka-p
                    paṅku nūṟṟ’ irupatt’ iraṇṭukku I-<hi rend="grantha">śrī</hi>-villiputtūr nāṉk’ ellaikk’ uṭpaṭṭa naṉ-cey puṉ-cey karuñ-ceyum nattamum nattappārum tōṭṭamum tōṭṭa-k-kollaikaḷum kuḷamum kuḷa-p-parippum kiṇaṟukaḷum maṟṟum e<choice><sic>ṟ</sic><corr>p</corr></choice>pērpaṭṭa <hi rend="grantha">samasta-prāpti</hi>kaḷum Iru-pattu m<choice><orig>u</orig><reg>ū</reg></choice>ṉṟ-āvatu nāḷ Eṇpatu varai-y-uḷḷa tēvatāṉam tiruviṭaiyāṭṭam paḷḷiccantam vaṭa-peruṅ-kōyil
                    <lb n="3"/>Uṭaiyāṉukkum cūṭi-k kuṭutt-aruḷiya nācciyāṟkum periyāḻvāṟkum Ivv-ūr <hi rend="grantha">brāhma</hi>ṇar pakkal vilaiyum āññātiyuṅ koṇṭum <hi rend="grantha">dā</hi>nam peṟṟum uṇṭāṉavai n<choice><orig>i</orig><reg>ī</reg></choice>kki n<choice><orig>i</orig><reg>ī</reg></choice>kki-y-uḷḷa 
                    cey puṉ-cey karuñ-cey nattamum nattappārum tōṭṭamum tōṭṭa-k-kollaikaḷum kuḷamum kuḷa-p-parippum kiṇaṟukaḷum maṟṟum eppērpaṭṭa <hi rend="grantha">samasta-prāpti</hi>kaḷu<supplied reason="omitted">m</supplied> muṉṉ-uṭaiyārum paḻam perumuḻavu<surplus>i</surplus>m mutalil tavittu or-oru purav’ ākki vaṭa-peruṅ-kōyil-uṭaiyaṉukkum cūṭi-k kuṭutt-āruḷiya nācciyāṟkum periyāḻvāṟkum tiruviṭaiyāṭṭam ākki nam pōl co
                    <lb n="4" break="no"/>⌉ṉai veṉṟa pāṇṭiya-c-catu<hi rend="grantha">rvvedi</hi>maṅkalam eṉṟu <hi rend="grantha">grāma</hi>m vaikka-p peṟa vēṇum eṉṟum ippaṭi
                </p>
                
