            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <p>
                    <lb n="1"/>I<hi rend="grantha">rājen<choice><orig>t</orig><reg>d</reg></choice>ra</hi>cōḻa-p-perumpaḷḷi Akkacālai-p-perum-paḷḷi Āḻvār kōyilukku tiru-v-u<hi rend="grantha">tsa</hi>vam Eḻun=taruḷa Āḻvār
                </p>
                <p>
                    Ivv-āḻvārai Eḻun=taruḷuvit=tār ciṟutavūr nālāṅkuṇākara-Uṭaiyār
                </p>
                
                <p>
                    <lb n="2"/><g ref="sym:flourish-taperIn" type="symbol">*</g> <hi rend="grantha">svasti śrī</hi>
                </p>
                <p>
                    pati<choice><orig>n</orig><reg>ṉ</reg></choice>-eṇ-vi<hi rend="grantha">ṣai</hi>yattukkum Akkacālaikaḷ nāyakar <g ref="sym:flourish-taperOut" type="symbol">*</g>
                </p>
                
            </div>
            
            <!--<div type="apparatus">
