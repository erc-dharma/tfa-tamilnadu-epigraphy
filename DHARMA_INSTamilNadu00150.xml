            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <ab>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </ab>
                
                <p>
                    tiruveṇ <gap reason="lost" quantity="5" unit="character" precision="low"/> cuḻi paṭṭaṉukkum nāṭ-uṭaiya perumāḷā <gap reason="lost" quantity="4" unit="character" precision="low"/> Uṭaiyār tiru-k-kōyil Ā<hi rend="grantha">śri</hi>yam-āka Eṅkaḷ tamaiyaṉār mutaliyār <gap reason="lost" quantity="4" unit="character" precision="low"/>
                    <lb n="2"/>ceyttu vāytta <gap reason="lost" quantity="4" unit="character" precision="low"/> paṭṭaṉukku <gap reason="lost" quantity="5" unit="character" precision="low"/> cuḻi Uṭaiyāṉ makaṉ tiru-naḷḷāṟ-uṭaiyāṉu <gap reason="lost" quantity="4" unit="character" precision="low"/> yār Eḻunt-aruḷa-p paṇṇiṉa Uṭaiyār tiru-valañcuḻi Uṭaiyār kōyi <gap reason="lost" quantity="4" unit="character" precision="low"/>
                    <lb n="3" break="no"/>kkum campattiṉ makaṉ <gap reason="lost" quantity="4" unit="character" precision="low"/> r tiru-valañcuḻi Uṭaiyāṉukkum collum paṭi Uṭaiyār tiru-naḷḷāṟu <gap reason="lost" quantity="5" unit="character" precision="low"/>
                    <lb n="4"/><gap reason="lost" quantity="4" unit="character" precision="low"/> <hi rend="grantha">śi</hi>va-<hi rend="grantha">brāhma</hi>ṇaṉ kāṇi perumāḷ <hi rend="grantha">sunda</hi>ra-pā<hi rend="grantha">ṇḍya-de</hi>vakku yāṇṭu <gap reason="lost" quantity="3" unit="character" precision="low"/>
                    <lb n="5"/><gap reason="lost" quantity="4" unit="character" precision="low"/> ṉeṭṭā <gap reason="lost" quantity="5" unit="character" precision="low"/> Ēṟṟi y-aruḷiṉa ṉāḷ mutal taṅkaḷukku-k kāṇi-y-āka muliyār niccayittu <gap reason="lost" quantity="3" unit="character" precision="low"/>
                    <lb n="6"/><gap reason="lost" quantity="4" unit="character" precision="low"/> paṭiyē nāṅkaḷ nālvarum pēṟkku Ēḻ’ arai y-āka vanta ṉāḷ-k kāṇi-y-āka-k koṇṭu <gap reason="lost" quantity="4" unit="character" precision="low"/>
                </p>
