                    <lb n="1"/>IN <expan><abbr>A</abbr><ex>NN</ex><abbr><hi rend="superscript">O</hi></abbr></expan> 1777, EN ONDER DE                
                    <lb n="2"/>LOFFEL<choice><orig>Y</orig><reg>IJ</reg></choice>KE REGERING
                    <lb n="3"/>VAN DEN <expan><abbr>WELED</abbr><ex>ELE</ex></expan>
                    GROOT
                    <lb n="4"/><expan><abbr>AGTB</abbr><ex>ARE</ex></expan> HEER GOUVERNEUR
                    <lb n="5"/>RE<choice><orig>Y</orig><reg>IJ</reg></choice>NIER VAN VLISSINGEN
                    <lb n="6"/>IS DEESE PAGOOD HERBOUWT,
                </p>
                
