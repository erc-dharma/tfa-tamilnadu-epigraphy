                <p>
                    <lb n="1"/>tiru-v-uṭai<unclear reason="eccentric_ductus">y</unclear>ār Ammai A
                    <lb n="2" break="no"/>kaḷaṅka-<add place="above">p</add>-perumāḷ
                </p>
                
            </div>
            
